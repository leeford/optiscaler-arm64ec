+bool SGSR2FeatureDx11::EvaluateInternal(ID3D11DeviceContext* InContext, NVSDK_NGX_Parameter* InParameters)
+{
+    LOG_FUNC();
+
+    if (!IsInited())
+        return false;
+
+    auto& cfg = *Config::Instance();
+
+    ID3D11Resource* paramColor = nullptr;
+    ID3D11Resource* paramVelocity = nullptr;
+    ID3D11Resource* paramDepth = nullptr;
+    ID3D11Resource* paramOutput = nullptr;
+
+    const auto getResource = [InParameters](const char* name, ID3D11Resource** resource)
+    {
+        if (InParameters->Get(name, resource) != NVSDK_NGX_Result_Success)
+            InParameters->Get(name, (void**) resource);
+    };
+
+    getResource(NVSDK_NGX_Parameter_Color, &paramColor);
+    getResource(NVSDK_NGX_Parameter_MotionVectors, &paramVelocity);
+    getResource(NVSDK_NGX_Parameter_Depth, &paramDepth);
+    getResource(NVSDK_NGX_Parameter_Output, &paramOutput);
+
+    _hasColor = paramColor != nullptr;
+    _hasMV = paramVelocity != nullptr;
+    _hasDepth = paramDepth != nullptr;
+    _hasOutput = paramOutput != nullptr;
+
+    if (!_hasColor || !_hasMV || !_hasDepth || !_hasOutput)
+    {
+        LOG_ERROR("Missing input! color: {}, motion: {}, depth: {}, output: {}", _hasColor, _hasMV, _hasDepth,
+                  _hasOutput);
+        return false;
+    }
+
+    ComPtr<ID3D11Texture2D> colorTexture;
+    ComPtr<ID3D11Texture2D> velocityTexture;
+    ComPtr<ID3D11Texture2D> depthTexture;
+    ComPtr<ID3D11Texture2D> outputTexture;
+
+    if (FAILED(paramColor->QueryInterface(IID_PPV_ARGS(&colorTexture))) ||
+        FAILED(paramVelocity->QueryInterface(IID_PPV_ARGS(&velocityTexture))) ||
+        FAILED(paramDepth->QueryInterface(IID_PPV_ARGS(&depthTexture))) ||
+        FAILED(paramOutput->QueryInterface(IID_PPV_ARGS(&outputTexture))))
+    {
+        LOG_ERROR("Inputs must be 2D textures");
+        return false;
+    }
+
+    D3D11_TEXTURE2D_DESC colorDesc {};
+    D3D11_TEXTURE2D_DESC velocityDesc {};
+    D3D11_TEXTURE2D_DESC depthDesc {};
+    D3D11_TEXTURE2D_DESC outputDesc {};
+
+    colorTexture->GetDesc(&colorDesc);
+    velocityTexture->GetDesc(&velocityDesc);
+    depthTexture->GetDesc(&depthDesc);
+    outputTexture->GetDesc(&outputDesc);
+
+    if (!(outputDesc.BindFlags & D3D11_BIND_UNORDERED_ACCESS))
+    {
+        LOG_ERROR("Output has no unordered access, bind flags: {:x}", outputDesc.BindFlags);
+        return false;
+    }
+
+    // Scene color isn't guaranteed to be readable by a shader
+    if (!(colorDesc.BindFlags & D3D11_BIND_SHADER_RESOURCE))
+    {
+        D3D11_TEXTURE2D_DESC currentCopy {};
+        if (_colorCopy != nullptr)
+            _colorCopy->GetDesc(&currentCopy);
+
+        if (currentCopy.Width != colorDesc.Width || currentCopy.Height != colorDesc.Height ||
+            currentCopy.Format != colorDesc.Format)
+        {
+            auto copyDesc = colorDesc;
+            copyDesc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+            copyDesc.MiscFlags = 0;
+
+            _colorCopy.Reset();
+            const auto hr = Device->CreateTexture2D(&copyDesc, nullptr, &_colorCopy);
+            if (FAILED(hr))
+            {
+                LOG_ERROR("Color copy error: {:x}", static_cast<unsigned long>(hr));
+                return false;
+            }
+        }
+
+        InContext->CopyResource(_colorCopy.Get(), colorTexture.Get());
+        colorTexture = _colorCopy;
+    }
+
+    unsigned int renderWidth = 0;
+    unsigned int renderHeight = 0;
+    GetRenderResolution(InParameters, &renderWidth, &renderHeight);
+
+    if (renderWidth == 0 || renderHeight == 0)
+    {
+        LOG_ERROR("Invalid render resolution: {}x{}", renderWidth, renderHeight);
+        return false;
+    }
+
+    bool recreated = false;
+    if (!EnsureBuffers(renderWidth, renderHeight, outputDesc.Width, outputDesc.Height, recreated))
+        return false;
+
+    unsigned int resetFlag = 0;
+    InParameters->Get(NVSDK_NGX_Parameter_Reset, &resetFlag);
+    const bool reset = resetFlag == 1 || recreated || _frameCount == 0;
+
+    float jitterX = 0.0f;
+    float jitterY = 0.0f;
+    InParameters->Get(NVSDK_NGX_Parameter_Jitter_Offset_X, &jitterX);
+    InParameters->Get(NVSDK_NGX_Parameter_Jitter_Offset_Y, &jitterY);
+
+    float mvScaleX = 1.0f;
+    float mvScaleY = 1.0f;
+    if (InParameters->Get(NVSDK_NGX_Parameter_MV_Scale_X, &mvScaleX) != NVSDK_NGX_Result_Success ||
+        InParameters->Get(NVSDK_NGX_Parameter_MV_Scale_Y, &mvScaleY) != NVSDK_NGX_Result_Success)
+    {
+        LOG_WARN("Can't get motion vector scales!");
+    }
+
+    float preExposure = 1.0f;
+    if (InParameters->Get(NVSDK_NGX_Parameter_DLSS_Pre_Exposure, &preExposure) != NVSDK_NGX_Result_Success ||
+        preExposure <= 0.0f)
+    {
+        preExposure = 1.0f;
+    }
+
+    float verticalFov = GetRadiansFromDeg(60.0f);
+    if (cfg.FsrVerticalFov.has_value())
+    {
+        verticalFov = GetRadiansFromDeg(cfg.FsrVerticalFov.value());
+    }
+    else if (cfg.FsrHorizontalFov.value_or_default() > 0.0f)
+    {
+        verticalFov = GetVerticalFovFromHorizontal(GetRadiansFromDeg(cfg.FsrHorizontalFov.value()),
+                                                   static_cast<float>(TargetWidth()),
+                                                   static_cast<float>(TargetHeight()));
+    }
+
+    const float renderW = static_cast<float>(renderWidth);
+    const float renderH = static_cast<float>(renderHeight);
+    const float displayW = static_cast<float>(outputDesc.Width);
+    const float displayH = static_cast<float>(outputDesc.Height);
+
+    Constants constants {};
+    constants.renderSize[0] = renderWidth;
+    constants.renderSize[1] = renderHeight;
+    constants.displaySize[0] = outputDesc.Width;
+    constants.displaySize[1] = outputDesc.Height;
+    constants.renderSizeRcp[0] = 1.0f / renderW;
+    constants.renderSizeRcp[1] = 1.0f / renderH;
+    constants.displaySizeRcp[0] = 1.0f / displayW;
+    constants.displaySizeRcp[1] = 1.0f / displayH;
+    constants.jitterOffset[0] = jitterX;
+    constants.jitterOffset[1] = jitterY;
+
+    const float motionSizeW = LowResMV() ? renderW : displayW;
+    const float motionSizeH = LowResMV() ? renderH : displayH;
+    constants.motionUvScale[0] = mvScaleX / motionSizeW;
+    constants.motionUvScale[1] = mvScaleY / motionSizeH;
+    constants.motionTexelScale[0] = motionSizeW / renderW;
+    constants.motionTexelScale[1] = motionSizeH / renderH;
+
+    if (JitteredMV() && !reset)
+    {
+        constants.jitterCancel[0] = (_prevJitter[0] - jitterX) / renderW;
+        constants.jitterCancel[1] = (_prevJitter[1] - jitterY) / renderH;
+    }
+
+    constants.depthSizeRcp[0] = 1.0f / static_cast<float>(depthDesc.Width);
+    constants.depthSizeRcp[1] = 1.0f / static_cast<float>(depthDesc.Height);
+
+    // History is tonemapped relative to the previous exposure
+    constants.preExposure =
+        _prevPreExposure > 0.0f && !reset ? std::clamp(_prevPreExposure / preExposure, 0.25f, 4.0f) : 1.0f;
+    constants.cameraFovAngleHor = std::tan(verticalFov * 0.5f) * renderW / renderH;
+    constants.minLerpContribution = MinLerpContribution;
+
+    // NGX has no camera matrices to tell if the camera moved. Always taking all 9 samples costs a little more than
+    // upstream's moving camera path, and minLerpContribution is cancelled per pixel by the motion vectors
+    constants.sameCamera = 1;
+    constants.reset = reset ? 1 : 0;
+    constants.depthInverted = DepthInverted() ? 1 : 0;
+
+    _prevJitter[0] = jitterX;
+    _prevJitter[1] = jitterY;
+    _prevPreExposure = preExposure;
+
+    auto colorSrv = CreateInputSrv(colorTexture.Get());
+    auto depthSrv = CreateInputSrv(depthTexture.Get());
+    auto velocitySrv = CreateInputSrv(velocityTexture.Get());
+
+    if (colorSrv == nullptr || depthSrv == nullptr || velocitySrv == nullptr)
+        return false;
+
+    D3D11_UNORDERED_ACCESS_VIEW_DESC outputUavDesc {};
+    outputUavDesc.Format = Shader_Dx11::TranslateTypelessFormats(outputDesc.Format);
+    outputUavDesc.ViewDimension = D3D11_UAV_DIMENSION_TEXTURE2D;
+
+    ComPtr<ID3D11UnorderedAccessView> outputUav;
+    auto hr = Device->CreateUnorderedAccessView(outputTexture.Get(), &outputUavDesc, &outputUav);
+    if (FAILED(hr))
+    {
+        LOG_ERROR("Output format {} error: {:x}", static_cast<int>(outputDesc.Format),
+                  static_cast<unsigned long>(hr));
+        return false;
+    }
+
+    D3D11_MAPPED_SUBRESOURCE mapped {};
+    hr = InContext->Map(_constantBuffer.Get(), 0, D3D11_MAP_WRITE_DISCARD, 0, &mapped);
+    if (FAILED(hr))
+    {
+        LOG_ERROR("Map error: {:x}", static_cast<unsigned long>(hr));
+        return false;
+    }
+
+    memcpy(mapped.pData, &constants, sizeof(constants));
+    InContext->Unmap(_constantBuffer.Get(), 0);
+
+    ComPtr<ID3D11ComputeShader> previousShader;
+    InContext->CSGetShader(&previousShader, nullptr, nullptr);
+
+    ID3D11Buffer* constantBuffers[] = { _constantBuffer.Get() };
+    ID3D11SamplerState* samplers[] = { _linearClamp.Get(), _pointClamp.Get() };
+    InContext->CSSetConstantBuffers(0, 1, constantBuffers);
+    InContext->CSSetSamplers(0, 2, samplers);
+
+    ID3D11ShaderResourceView* const nullSrvs[3] = {};
+    ID3D11UnorderedAccessView* const nullUavs[2] = {};
+
+    {
+        ID3D11ShaderResourceView* srvs[] = { colorSrv.Get(), depthSrv.Get(), velocitySrv.Get() };
+        ID3D11UnorderedAccessView* uavs[] = { _motionDepthClip.uav.Get(), _colorLuma.uav.Get() };
+
+        InContext->CSSetShader(_convertShader.Get(), nullptr, 0);
+        InContext->CSSetShaderResources(0, 3, srvs);
+        InContext->CSSetUnorderedAccessViews(0, 2, uavs, nullptr);
+        InContext->Dispatch((renderWidth + ThreadGroupSize - 1) / ThreadGroupSize,
+                            (renderHeight + ThreadGroupSize - 1) / ThreadGroupSize, 1);
+        InContext->CSSetUnorderedAccessViews(0, 2, nullUavs, nullptr);
+        InContext->CSSetShaderResources(0, 3, nullSrvs);
+    }
+
+    {
+        const auto& prevHistory = _history[_historyIndex];
+        const auto& nextHistory = _history[_historyIndex ^ 1];
+
+        ID3D11ShaderResourceView* srvs[] = { prevHistory.srv.Get(), _motionDepthClip.srv.Get(), _colorLuma.srv.Get() };
+        ID3D11UnorderedAccessView* uavs[] = { outputUav.Get(), nextHistory.uav.Get() };
+
+        InContext->CSSetShader(_upscaleShader.Get(), nullptr, 0);
+        InContext->CSSetShaderResources(0, 3, srvs);
+        InContext->CSSetUnorderedAccessViews(0, 2, uavs, nullptr);
+        InContext->Dispatch((outputDesc.Width + ThreadGroupSize - 1) / ThreadGroupSize,
+                            (outputDesc.Height + ThreadGroupSize - 1) / ThreadGroupSize, 1);
+        InContext->CSSetUnorderedAccessViews(0, 2, nullUavs, nullptr);
+        InContext->CSSetShaderResources(0, 3, nullSrvs);
+    }
+
+    _historyIndex ^= 1;
+
+    // The base class restores everything but the shader itself
+    InContext->CSSetShader(previousShader.Get(), nullptr, 0);
+
+    return true;
+}
diff --git a/OptiScaler/upscalers/sgsr2/SGSR2Feature_Dx11.h b/OptiScaler/upscalers/sgsr2/SGSR2Feature_Dx11.h
new file mode 100644
index 0000000..5c7493d
--- /dev/null
+++ b/OptiScaler/upscalers/sgsr2/SGSR2Feature_Dx11.h
@@ -0,0 +1,73 @@
+#pragma once
+#include <upscalers/IFeature_Dx11.h>
+
+#include <wrl/client.h>
+
+// Snapdragon Game Super Resolution 2, 2-pass compute variant
+class SGSR2FeatureDx11 : public IFeature_Dx11
+{
+  private:
+    template <typename T> using ComPtr = Microsoft::WRL::ComPtr<T>;
+
+    // Must match the Params cbuffer in sgsr2_common.hlsli
+    struct Constants
+    {
+        uint32_t renderSize[2];
+        uint32_t displaySize[2];
+        float renderSizeRcp[2];
+        float displaySizeRcp[2];
+        float jitterOffset[2];
+        float motionUvScale[2];
+        float motionTexelScale[2];
+        float jitterCancel[2];
+        float depthSizeRcp[2];
+        float preExposure;
+        float cameraFovAngleHor;
+        float minLerpContribution;
+        uint32_t sameCamera;
+        uint32_t reset;
+        uint32_t depthInverted;
+    };
+
+    struct RenderTexture
+    {
+        ComPtr<ID3D11Texture2D> texture;
+        ComPtr<ID3D11ShaderResourceView> srv;
+        ComPtr<ID3D11UnorderedAccessView> uav;
+    };
+
+    ComPtr<ID3D11ComputeShader> _convertShader;
+    ComPtr<ID3D11ComputeShader> _upscaleShader;
+    ComPtr<ID3D11Buffer> _constantBuffer;
+    ComPtr<ID3D11SamplerState> _linearClamp;
+    ComPtr<ID3D11SamplerState> _pointClamp;
+
+    RenderTexture _motionDepthClip;
+    RenderTexture _colorLuma;
+    RenderTexture _history[2];
+    ComPtr<ID3D11Texture2D> _colorCopy;
+
+    uint32_t _bufferRenderWidth = 0;
+    uint32_t _bufferRenderHeight = 0;
+    uint32_t _bufferDisplayWidth = 0;
+    uint32_t _bufferDisplayHeight = 0;
+    uint32_t _historyIndex = 0;
+
+    float _prevJitter[2] = {};
+    float _prevPreExposure = 0.0f;
+
+    bool CreateRenderTexture(uint32_t width, uint32_t height, DXGI_FORMAT format, RenderTexture& out);
+    bool EnsureBuffers(uint32_t renderWidth, uint32_t renderHeight, uint32_t displayWidth, uint32_t displayHeight,
+                       bool& recreated);
+    ComPtr<ID3D11ShaderResourceView> CreateInputSrv(ID3D11Resource* resource);
+
+  public:
+    SGSR2FeatureDx11(unsigned int InHandleId, NVSDK_NGX_Parameter* InParameters);
+
+    bool InitInternal(ID3D11DeviceContext* InContext, NVSDK_NGX_Parameter* InParameters) override;
+    bool EvaluateInternal(ID3D11DeviceContext* InContext, NVSDK_NGX_Parameter* InParameters) override;
+
+    feature_version Version() override { return { 2, 0, 0 }; }
+    Upscaler GetUpscalerType() const final { return Upscaler::SGSR2; }
+    bool IsWithDx12() override { return false; }
+};
