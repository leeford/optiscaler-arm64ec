From 60fe43661dd6c51c35aa80962379ae2eeaf82f96 Mon Sep 17 00:00:00 2001
From: optiscaler-arm64ec <optiscaler-arm64ec@users.noreply.github.com>
Date: Sat, 7 Nov 2026 19:26:40 +0000
Subject: [PATCH 1/3] Install builds from optiscaler-arm64ec, including the
 OptiScaler/ runtimes

Point REPO at the optiscaler-arm64ec build repo (overridable with
OPTISCALER_RELEASE_REPO), extract and install the OptiScaler/ folder with
the x64 XeSS, FidelityFX and D3D12 runtimes, and match licenses/ in any case.

Backups are now keyed by the path relative to the game folder, so files in
subfolders (OptiScaler/libxess.dll, OptiScaler/plugins/OptiPatcher.asi) are
recognised as ours on reinstall instead of being backed up as originals.
---
 py_modules/opti_install.py | 32 +++++++++++++++++++++++++++-----
 py_modules/opti_release.py | 15 +++++++++++----
 2 files changed, 38 insertions(+), 9 deletions(-)

diff --git a/py_modules/opti_install.py b/py_modules/opti_install.py
index edb8ed9..e39d2f7 100644
--- a/py_modules/opti_install.py
+++ b/py_modules/opti_install.py
@@ -36,7 +36,8 @@ FILES_WE_LEAVE = ("OptiScaler.log", "OptiScaler.ini.bak")
 # The default the shipped ini documents for [Plugins] Path, so the file goes
 # here and Path stays at auto.
 PATCHER_REL = "OptiScaler/plugins/OptiPatcher.asi"
-PATCHER_DIRS = ("OptiScaler/plugins", "OptiScaler")
+# Deepest first, so pruning removes empty children before their parent.
+PATCHER_DIRS = ("OptiScaler/plugins", "OptiScaler/D3D12_OptiScaler", "OptiScaler")
 
 
 class InstallError(Exception):
@@ -134,10 +135,17 @@ def _write_marker(directory: Path, data: dict) -> None:
         json.dump(data, handle, indent=2)
 
 
-def _back_up(target: Path, marker: Optional[dict], backups: dict) -> None:
+def _back_up(target: Path, marker: Optional[dict], backups: dict,
+             directory: Optional[Path] = None) -> None:
+    """Move a file we are about to overwrite aside, unless it is ours already.
+
+    Files are keyed by their path relative to the install directory, so ones in
+    subfolders (OptiScaler/libxess.dll) are recognised as ours on reinstall.
+    """
     if not target.exists():
         return
-    previously_ours = marker is not None and target.name in (marker.get("files") or [])
+    key = target.relative_to(directory).as_posix() if directory else target.name
+    previously_ours = marker is not None and key in (marker.get("files") or [])
     if previously_ours:
         target.unlink()
         return
@@ -147,7 +155,7 @@ def _back_up(target: Path, marker: Optional[dict], backups: dict) -> None:
         target.unlink()
         return
     target.rename(backup)
-    backups[target.name] = backup.name
+    backups[key] = backup.relative_to(directory).as_posix() if directory else backup.name
     log.info("backed up existing %s", target)
 
 
@@ -186,13 +194,27 @@ def install_into(directory: Path, build: Path, dll_name: str,
     if patcher_src is not None:
         patcher_target = directory / PATCHER_REL
         patcher_target.parent.mkdir(parents=True, exist_ok=True)
-        _back_up(patcher_target, marker, backups)
+        _back_up(patcher_target, marker, backups, directory)
         shutil.copy2(patcher_src, patcher_target)
         created.append(PATCHER_REL)
     elif marker and PATCHER_REL in (marker.get("files") or []):
         _restore_one(directory, PATCHER_REL, marker)
         _prune_dirs(directory)
 
+    # The x64 vendor runtimes (XeSS, FidelityFX, D3D12 Agility) OptiScaler loads
+    # from its own OptiScaler/ folder. Builds without the folder skip this.
+    runtime_root = build / release.RUNTIME_DIR
+    if runtime_root.is_dir():
+        for source in sorted(runtime_root.rglob("*")):
+            if not source.is_file():
+                continue
+            relative = source.relative_to(build).as_posix()
+            target = directory / relative
+            target.parent.mkdir(parents=True, exist_ok=True)
+            _back_up(target, marker, backups, directory)
+            shutil.copy2(source, target)
+            created.append(relative)
+
     ini_target = directory / INI_NAME
     _back_up(ini_target, marker, backups)
     ini_text = source_ini.read_text(encoding="utf-8", errors="replace") \
diff --git a/py_modules/opti_release.py b/py_modules/opti_release.py
index 8f9e813..ab75034 100644
--- a/py_modules/opti_release.py
+++ b/py_modules/opti_release.py
@@ -20,10 +20,12 @@ log = logging.getLogger("optiscaler.release")
 
 # Tags here are not version numbers and an asset can be replaced in place, so
 # the cache is keyed on the asset's sha256.
-REPO = "justradical/Sloptiscaler"
+# Where builds come from. OPTISCALER_RELEASE_REPO overrides it without editing
+# the plugin, e.g. to go back to "justradical/Sloptiscaler".
+REPO = os.environ.get("OPTISCALER_RELEASE_REPO") or "YOUR_GITHUB_USER/optiscaler-arm64ec"
 RELEASE_URL = f"https://github.com/{REPO}/releases/latest"
 API_ROOT = "https://api.github.com"
-USER_AGENT = "OptiScaler-decky/1.0 (+https://github.com/justradical/Sloptiscaler)"
+USER_AGENT = f"OptiScaler-decky/1.0 (+https://github.com/{REPO})"
 
 # Upstream names it like OptiScaler-SGSR2-arm64ec-727b8dd.zip, but a release
 # that names its zip anything else is still the build we want.
@@ -31,8 +33,11 @@ ASSET_PATTERN = re.compile(r"arm64ec.*\.zip$", re.IGNORECASE)
 _HASH_IN_NAME = re.compile(r"-([0-9a-f]{7,40})\.zip$", re.IGNORECASE)
 
 # Only these come out of the zip, so a crafted path cannot escape the build dir.
+# OptiScaler/ holds the x64 XeSS, FidelityFX and D3D12 runtimes; directory
+# prefixes are matched case-insensitively ("Licenses/" or "licenses/").
 WANTED_FILES = ("OptiScaler.dll", "OptiScaler.ini", "README.md")
-WANTED_DIRS = ("licenses/",)
+WANTED_DIRS = ("licenses/", "optiscaler/")
+RUNTIME_DIR = "OptiScaler"
 
 DLL_NAME = "OptiScaler.dll"
 INI_NAME = "OptiScaler.ini"
@@ -281,7 +286,9 @@ def _extract(zip_path: Path, build: Path) -> None:
             for name in names:
                 if name.endswith("/"):
                     continue
-                wanted = name in WANTED_FILES or name.startswith(WANTED_DIRS)
+                wanted = name in WANTED_FILES or name.lower().startswith(WANTED_DIRS)
+                if ".." in name.split("/"):
+                    continue
                 if not wanted:
                     continue
                 # name is matched against a fixed whitelist above, so it cannot
